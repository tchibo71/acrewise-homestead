{
  "name": "FarmProfile",
  "type": "object",
  "properties": {
    "farm_name": {
      "type": "string",
      "description": "Name of the farm"
    },
    "location_address": {
      "type": "string",
      "description": "Physical address"
    },
    "grid_coordinates": {
      "type": "string",
      "description": "GPS coordinates"
    },
    "plat_map_number": {
      "type": "string",
      "description": "Legal plat/parcel number"
    },
    "usda_zone": {
      "type": "string",
      "description": "USDA hardiness zone (e.g., 7a, 7b, 8a)"
    },
    "total_acreage": {
      "type": "number",
      "description": "Total farm acreage"
    },
    "usable_acreage": {
      "type": "number",
      "description": "Acreage available for production"
    },
    "labor_rate_per_hour": {
      "type": "number",
      "description": "Hourly labor rate in dollars for COGS calculations",
      "default": 15
    },
    "soil_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "soil_type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "depth": {
            "type": "string"
          },
          "acreage": {
            "type": "number"
          }
        }
      }
    },
    "infrastructure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "enum": [
              "excellent",
              "good",
              "fair",
              "poor"
            ]
          },
          "year_built": {
            "type": "string"
          }
        }
      }
    },
    "water_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_type": {
            "type": "string"
          },
          "capacity": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "soil_series": {
      "type": "string",
      "description": "USDA soil series name from SDA lookup at property center point"
    },
    "flood_zone": {
      "type": "string",
      "description": "FEMA flood zone designation at property center point"
    },
    "is_in_floodplain": {
      "type": "boolean",
      "description": "Whether the property center point falls within a FEMA SFHA floodplain"
    },
    "elevation_ft": {
      "type": "number",
      "description": "Elevation in feet at property center point from USGS National Map"
    },
    "hardiness_zone": {
      "type": "string",
      "description": "USDA plant hardiness zone (e.g., 7a) from ZIP code lookup"
    },
    "wetlands_present": {
      "type": "boolean",
      "description": "Whether FWS National Wetlands Inventory data indicates wetlands at the property"
    },
    "site_data_fetched_date": {
      "type": "string",
      "format": "date",
      "description": "Date when site data (soil, flood, elevation, hardiness, wetlands) was last fetched"
    },
    "mushroom_operation_scale": {
      "type": "string",
      "enum": [
        "hobby",
        "commercial"
      ],
      "default": "hobby",
      "description": "Scale of mushroom growing operation \u2014 controls visibility of advanced lab, facility, and wholesale tools"
    },
    "ai_recommendations": {
      "type": "string",
      "description": "AI-generated recommendations for improvements"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "farm_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}