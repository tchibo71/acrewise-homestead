{
  "name": "GardenPlot",
  "type": "object",
  "properties": {
    "plot_name": {
      "type": "string"
    },
    "plot_type": {
      "type": "string",
      "enum": [
        "raised_bed",
        "in_ground",
        "container",
        "greenhouse",
        "hoop_house",
        "vertical"
      ],
      "description": "Type of garden plot"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "dimensions": {
      "type": "string",
      "description": "e.g., 4x8 feet, 100 sq ft"
    },
    "area_sq_ft": {
      "type": "number"
    },
    "soil_type": {
      "type": "string"
    },
    "hardiness_zone": {
      "type": "string",
      "description": "USDA plant hardiness zone (e.g., 7a) from site data lookup"
    },
    "flood_zone": {
      "type": "string",
      "description": "FEMA flood zone designation at plot center point"
    },
    "wetlands_present": {
      "type": "boolean",
      "description": "Whether FWS National Wetlands Inventory data indicates wetlands at the plot"
    },
    "site_data_fetched_date": {
      "type": "string",
      "format": "date",
      "description": "Date when site data (soil, flood, hardiness, wetlands) was last fetched"
    },
    "sun_exposure": {
      "type": "string",
      "enum": [
        "full_sun",
        "partial_shade",
        "full_shade"
      ],
      "description": "Daily sun exposure"
    },
    "irrigation_method": {
      "type": "string"
    },
    "current_crops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rotation_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "number"
          },
          "season": {
            "type": "string"
          },
          "crops": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "soil_amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "amendment_type": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          }
        }
      }
    },
    "last_soil_test_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "fallow",
        "cover_crop",
        "planning"
      ],
      "default": "active"
    },
    "ai_recommendations": {
      "type": "string",
      "description": "AI-generated crop rotation and companion planting suggestions"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plot_name",
    "plot_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}