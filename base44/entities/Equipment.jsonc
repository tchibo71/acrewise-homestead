{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "equipment_name": {
      "type": "string",
      "description": "Name of equipment"
    },
    "equipment_type": {
      "type": "string",
      "enum": [
        "tractor",
        "mower",
        "tiller",
        "harvester",
        "sprayer",
        "truck",
        "trailer",
        "atv",
        "hand_tool",
        "power_tool",
        "processing_equipment",
        "irrigation_equipment",
        "other"
      ],
      "description": "Type of equipment"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "current_value": {
      "type": "number",
      "description": "Current estimated value"
    },
    "condition": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor",
        "needs_repair"
      ],
      "default": "good"
    },
    "storage_location": {
      "type": "string"
    },
    "last_maintenance_date": {
      "type": "string",
      "format": "date"
    },
    "next_maintenance_due": {
      "type": "string",
      "format": "date"
    },
    "maintenance_interval_days": {
      "type": "number",
      "description": "Days between maintenance"
    },
    "operating_hours": {
      "type": "number",
      "description": "Total operating hours"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "gasoline",
        "diesel",
        "electric",
        "propane",
        "manual",
        "none"
      ]
    },
    "warranty_expiration": {
      "type": "string",
      "format": "date"
    },
    "insurance_policy": {
      "type": "string"
    },
    "insurance_value": {
      "type": "number"
    },
    "manual_url": {
      "type": "string",
      "description": "Link to user manual"
    },
    "parts_supplier": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "in_repair",
        "out_of_service",
        "rented_out",
        "sold"
      ],
      "default": "operational"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "equipment_name",
    "equipment_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}