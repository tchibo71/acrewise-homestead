{
  "name": "CropPlan",
  "type": "object",
  "properties": {
    "crop_name": {
      "type": "string"
    },
    "variety": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "planting_date": {
      "type": "string",
      "format": "date"
    },
    "harvest_date": {
      "type": "string",
      "format": "date"
    },
    "days_to_harvest": {
      "type": "number",
      "description": "Days from planting/transplanting to harvest"
    },
    "start_indoors_date": {
      "type": "string",
      "format": "date",
      "description": "When seeds were started indoors"
    },
    "transplant_date": {
      "type": "string",
      "format": "date",
      "description": "When seedlings were transplanted outdoors"
    },
    "hardening_days": {
      "type": "number",
      "description": "Days needed to harden off seedlings before transplanting"
    },
    "planting_method": {
      "type": "string",
      "enum": [
        "direct_sow",
        "start_indoors",
        "transplant_seedling"
      ],
      "description": "How this crop was planted"
    },
    "is_second_planting": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a second/succession planting"
    },
    "frost_tolerance": {
      "type": "string",
      "description": "Frost tolerance: Frost tolerant, Half-hardy, or Frost sensitive"
    },
    "germination_days": {
      "type": "number",
      "description": "Days for seeds to germinate"
    },
    "succession_interval_days": {
      "type": "number",
      "description": "How often to re-plant for continuous harvest (0 if not applicable)"
    },
    "location": {
      "type": "string",
      "description": "Field or plot location"
    },
    "acreage": {
      "type": "number"
    },
    "previous_crop": {
      "type": "string",
      "description": "For rotation tracking"
    },
    "planned_next_crop": {
      "type": "string"
    },
    "seed_source": {
      "type": "string"
    },
    "seed_cost": {
      "type": "number"
    },
    "expected_yield": {
      "type": "number"
    },
    "actual_yield": {
      "type": "number"
    },
    "yield_unit": {
      "type": "string"
    },
    "fertilizer_plan": {
      "type": "string"
    },
    "pest_management_plan": {
      "type": "string"
    },
    "irrigation_needs": {
      "type": "string"
    },
    "labor_hours_estimate": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "ai_recommendations": {
      "type": "string",
      "description": "AI-generated planting and rotation recommendations"
    }
  },
  "required": [
    "crop_name",
    "year"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}