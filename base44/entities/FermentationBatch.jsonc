{
  "name": "FermentationBatch",
  "type": "object",
  "properties": {
    "batch_name": {
      "type": "string",
      "description": "Name or identifier for this fermentation batch"
    },
    "fermentation_type": {
      "type": "string",
      "enum": [
        "sauerkraut",
        "kimchi",
        "pickles",
        "hot_sauce",
        "salsa",
        "carrots",
        "beets",
        "mixed_vegetables",
        "sourdough",
        "kombucha",
        "grape_juice",
        "wine",
        "cider",
        "mead",
        "vinegar",
        "beer",
        "fermented_sausage",
        "salami",
        "cured_meat",
        "cheese_fresh",
        "cheese_semi_hard",
        "cheese_hard",
        "cheese_blue",
        "cheese_mold_ripened",
        "other"
      ],
      "description": "Type of fermentation"
    },
    "primary_produce": {
      "type": "string",
      "description": "Main vegetable, fruit, or ingredient being fermented"
    },
    "meat_type": {
      "type": "string",
      "description": "Type of meat for fermented meat products (e.g., Pork, Beef, Venison)"
    },
    "culture_type": {
      "type": "string",
      "description": "Starter culture used (e.g., Mesophilic, Thermophilic, MA 4002, Fromage Blanc)"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_name": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "weight_unit": {
            "type": "string",
            "enum": [
              "lbs",
              "oz",
              "kg",
              "g"
            ],
            "default": "lbs"
          }
        }
      },
      "description": "List of all ingredients with individual weights"
    },
    "total_weight": {
      "type": "number",
      "description": "Total weight of all ingredients combined"
    },
    "total_weight_unit": {
      "type": "string",
      "enum": [
        "lbs",
        "oz",
        "kg",
        "g"
      ],
      "default": "lbs"
    },
    "preservative_type": {
      "type": "string",
      "enum": [
        "salt",
        "sugar",
        "cure",
        "none"
      ],
      "default": "salt",
      "description": "Primary preservative agent: salt (vegetable ferments), sugar (fruit/beverage ferments), cure (meat curing - nitrite/nitrate), or none"
    },
    "salt_weight": {
      "type": "number",
      "description": "Weight of salt used"
    },
    "salt_percentage": {
      "type": "number",
      "description": "Salt as percentage of total vegetable weight (typically 2-3%)"
    },
    "brine_type": {
      "type": "string",
      "enum": [
        "dry_salt",
        "brine_solution",
        "no_salt"
      ],
      "default": "dry_salt",
      "description": "Method of salting"
    },
    "sugar_weight": {
      "type": "number",
      "description": "Weight of sugar used"
    },
    "sugar_percentage": {
      "type": "number",
      "description": "Sugar as percentage of total weight (for fruit/beverage ferments)"
    },
    "cure_type": {
      "type": "string",
      "enum": [
        "cure_1",
        "cure_2"
      ],
      "description": "Cure #1 (sodium nitrite) for short-term cured meats, Cure #2 (sodium nitrate) for dry-cured/aged meats"
    },
    "cure_weight": {
      "type": "number",
      "description": "Weight of curing salt used (in grams or oz)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When fermentation began"
    },
    "target_completion_date": {
      "type": "string",
      "format": "date",
      "description": "Expected completion date"
    },
    "actual_completion_date": {
      "type": "string",
      "format": "date",
      "description": "When fermentation actually completed"
    },
    "fermentation_days": {
      "type": "number",
      "description": "Total days fermented"
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "container_type": {
            "type": "string",
            "description": "Type of container (e.g., Mason jar, Crock)"
          },
          "container_size": {
            "type": "string",
            "description": "Size of container (e.g., Half gallon, Quart)"
          },
          "quantity": {
            "type": "number",
            "default": 1,
            "description": "How many containers of this type and size"
          }
        }
      },
      "description": "List of containers used with quantities for tracking production volume"
    },
    "container_type": {
      "type": "string",
      "description": "Container type (legacy field - use containers array for multiple sizes)"
    },
    "container_size": {
      "type": "string",
      "description": "Container size (legacy field - use containers array for multiple sizes)"
    },
    "fermentation_temperature": {
      "type": "number",
      "description": "Average temperature in Fahrenheit"
    },
    "aging_humidity": {
      "type": "number",
      "description": "Aging/curing humidity percentage (typically 75-85% for dry-cured meats and aged cheese)"
    },
    "is_smoked": {
      "type": "boolean",
      "default": false,
      "description": "Whether this product was smoked (for fermented meats)"
    },
    "smoking_method": {
      "type": "string",
      "enum": [
        "cold_smoke",
        "hot_smoke",
        "liquid_smoke"
      ],
      "description": "Smoking method used"
    },
    "smoking_temperature": {
      "type": "number",
      "description": "Smoking temperature in Fahrenheit"
    },
    "smoking_duration_hours": {
      "type": "number",
      "description": "Total smoking duration in hours"
    },
    "wood_type": {
      "type": "string",
      "description": "Type of wood used for smoking (e.g., Hickory, Apple, Cherry)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "failed",
        "refrigerated"
      ],
      "default": "active"
    },
    "problems_encountered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of issues during fermentation"
    },
    "solutions_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "How problems were resolved"
    },
    "taste_notes": {
      "type": "string",
      "description": "Flavor profile and quality notes"
    },
    "texture_notes": {
      "type": "string",
      "description": "Texture evaluation"
    },
    "success_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Overall success rating 1-5"
    },
    "would_repeat": {
      "type": "boolean",
      "description": "Would you make this recipe again"
    },
    "recipe_notes": {
      "type": "string",
      "description": "Recipe details, spices, special techniques"
    },
    "general_notes": {
      "type": "string",
      "description": "General observations and notes"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photo URLs of fermentation process"
    }
  },
  "required": [
    "batch_name",
    "fermentation_type",
    "primary_produce",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}