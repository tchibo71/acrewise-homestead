{
  "name": "Pasture",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the pasture"
    },
    "acreage": {
      "type": "number",
      "description": "Size of the pasture in acres"
    },
    "location_notes": {
      "type": "string",
      "description": "Location details or landmarks"
    },
    "rest_period_days": {
      "type": "number",
      "default": 21,
      "description": "Recommended rest days before regrazing"
    },
    "status": {
      "type": "string",
      "enum": [
        "resting",
        "grazing",
        "needs_attention"
      ],
      "default": "resting",
      "description": "Current pasture status"
    },
    "last_grazed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the pasture was last grazed"
    },
    "notes": {
      "type": "string",
      "description": "General notes about the pasture"
    },
    "team_owner_email": {
      "type": "string",
      "description": "Email of the team owner for shared access"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.team_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.team_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}