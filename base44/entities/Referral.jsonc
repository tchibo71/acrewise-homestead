{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email of person who made the referral"
    },
    "referral_code": {
      "type": "string",
      "description": "The referral code used"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of person who was referred"
    },
    "referred_name": {
      "type": "string",
      "description": "Name of referred person"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "signed_up",
        "subscribed",
        "validated",
        "expired"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "click_date": {
      "type": "string",
      "format": "date",
      "description": "When the referral link was clicked"
    },
    "signup_date": {
      "type": "string",
      "format": "date",
      "description": "Date referred user signed up"
    },
    "subscription_date": {
      "type": "string",
      "format": "date",
      "description": "Date referred user subscribed"
    },
    "validation_date": {
      "type": "string",
      "format": "date",
      "description": "Date when 7 days passed and referral was validated"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Date when referral expires (30 days after click)"
    },
    "reward_earned": {
      "type": "number",
      "description": "Discount percentage earned (25, 50, or 100)"
    },
    "reward_applied": {
      "type": "boolean",
      "default": false,
      "description": "Whether the reward has been applied to billing"
    },
    "reward_applied_date": {
      "type": "string",
      "format": "date",
      "description": "When the reward was applied"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "referrer_email",
    "referral_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "referrer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}