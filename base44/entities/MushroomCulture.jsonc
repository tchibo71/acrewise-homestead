{
  "name": "MushroomCulture",
  "type": "object",
  "properties": {
    "strain_name": {
      "type": "string",
      "description": "Name or identifier for this culture/strain"
    },
    "species": {
      "type": "string",
      "enum": [
        "oyster",
        "shiitake",
        "lions_mane",
        "wine_cap",
        "button",
        "portobello",
        "reishi",
        "maitake",
        "other"
      ],
      "description": "Mushroom species"
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "tissue_culture_clone",
        "spore_isolate",
        "purchased_culture",
        "purchased_liquid_culture",
        "purchased_plug_spawn"
      ],
      "description": "How this culture was obtained"
    },
    "source": {
      "type": "string",
      "description": "Supplier name, or 'self-isolated from [description]' if cloned/isolated in-house"
    },
    "isolation_or_purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date the culture was isolated or purchased"
    },
    "parent_culture_id": {
      "type": "string",
      "description": "If this is a clone/subculture of an existing strain in the library, link to that MushroomCulture record"
    },
    "agar_recipe": {
      "type": "string",
      "enum": [
        "pda_potato_dextrose",
        "mea_malt_extract",
        "other"
      ],
      "description": "Agar recipe used for this culture"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "false if this strain has been retired/contaminated out"
    },
    "performance_notes": {
      "type": "string",
      "description": "Observed characteristics - yield, speed, resilience, flavor"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photo URLs of the culture"
    },
    "notes": {
      "type": "string",
      "description": "General notes"
    },
    "team_owner_email": {
      "type": "string",
      "description": "Email of the team owner for shared access"
    }
  },
  "required": [
    "strain_name",
    "species",
    "origin_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.team_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.team_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}