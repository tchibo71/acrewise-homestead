{
  "name": "FinancialLoan",
  "type": "object",
  "properties": {
    "loan_name": {
      "type": "string"
    },
    "lender": {
      "type": "string"
    },
    "loan_type": {
      "type": "string",
      "enum": [
        "mortgage",
        "equipment",
        "operating",
        "line_of_credit",
        "other"
      ]
    },
    "original_amount": {
      "type": "number"
    },
    "current_balance": {
      "type": "number"
    },
    "interest_rate": {
      "type": "number"
    },
    "term_months": {
      "type": "number"
    },
    "monthly_payment": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "maturity_date": {
      "type": "string",
      "format": "date"
    },
    "payment_schedule": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annually"
      ]
    },
    "collateral": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paid_off",
        "refinanced"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "loan_name",
    "lender",
    "loan_type",
    "original_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}